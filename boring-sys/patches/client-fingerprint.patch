+int SSL_set_client_fingerprint(SSL *ssl, unsigned profile) {
+  if (!ssl || !ssl->config || ssl->server || SSL_is_dtls(ssl) || SSL_is_quic(ssl) ||
+      ssl->s3->initial_handshake_complete ||
+      (ssl->s3->hs != nullptr && ssl->s3->hs->max_version != 0) ||
+      ssl->config->client_fingerprint != 0 || profile < 1 || profile > 4) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  ssl->config->client_fingerprint = static_cast<uint8_t>(profile);
+  return 1;
+}
