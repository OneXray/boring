+bool ssl_verify_jls_server_hello(SSL_HANDSHAKE *hs, Span<const uint8_t> msg) {
+  if (!hs->config->jls_client) {
+    return true;
+  }
+  auto &state = *hs->config->jls_client;
+  struct Consume {
+    SSL_CONFIG::JlsClient &state;
+    ~Consume() { state.ClearCredentials(); }
+  } consume{state};
+  JlsSecrets secrets;
+  if (!hs->jls_hello_sealed || hs->jls_server_authenticated ||
+      msg.size() < 38 || msg[0] != SSL3_MT_SERVER_HELLO ||
+      ssl_protocol_version(hs->ssl) != TLS1_3_VERSION ||
+      !jls_hello_hash(state.password, msg, secrets.key) ||
+      !jls_hello_hash(state.username, msg, secrets.nonce)) {
+    return false;
+  }
+  ScopedEVP_CIPHER_CTX ctx;
+  int len = 0, tail = 0;
+  uint8_t tag[16];
+  OPENSSL_memcpy(tag, msg.data() + 22, sizeof(tag));
+  const bool ok =
+      EVP_DecryptInit_ex(ctx.get(), EVP_aes_256_gcm(), nullptr,
+                         nullptr, nullptr) &&
+      EVP_CIPHER_CTX_ctrl(ctx.get(), EVP_CTRL_GCM_SET_IVLEN, 32, nullptr) &&
+      EVP_DecryptInit_ex(ctx.get(), nullptr, nullptr,
+                         secrets.key, secrets.nonce) &&
+      EVP_DecryptUpdate(ctx.get(), secrets.seed, &len, msg.data() + 6, 16) &&
+      len == 16 &&
+      EVP_CIPHER_CTX_ctrl(ctx.get(), EVP_CTRL_GCM_SET_TAG, 16, tag) &&
+      EVP_DecryptFinal_ex(ctx.get(), secrets.seed + len, &tail) && tail == 0;
+  hs->jls_server_authenticated = ok;
+  return ok;
+}
