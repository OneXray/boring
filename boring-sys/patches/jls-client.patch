+      username_len > 65535 || !password || password_len == 0 ||
+      password_len > 65535 || ssl->server || SSL_is_dtls(ssl) ||
+      SSL_is_quic(ssl) || ssl->session || ssl->enable_early_data ||
+      ssl->s3->initial_handshake_complete ||
+      (ssl->s3->hs && ssl->s3->hs->max_version != 0) ||
+      ssl->config->reality_client || ssl->config->shadow_tls_v3 ||
+      ssl->config->jls_client ||
+      !ssl->config->client_ech_config_list.empty()) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  auto &state = ssl->config->jls_client.emplace();
+  if (!state.username.CopyFrom(Span(username, username_len)) ||
+      !state.password.CopyFrom(Span(password, password_len))) {
+    ssl->config->jls_client.reset();
+    return 0;
+  }
+  return 1;
+}
