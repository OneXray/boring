+// JLS uses the complete native hello with its random field zeroed, not
+// mutable BIO bytes. SHA-256 and variable-nonce AES-GCM stay native.
+struct JlsSecrets {
+  uint8_t key[32] = {};
+  uint8_t nonce[32] = {};
+  uint8_t seed[32] = {};
+  ~JlsSecrets() { OPENSSL_cleanse(this, sizeof(*this)); }
+};
+
+static bool jls_hello_hash(Span<const uint8_t> credential,
+                           Span<const uint8_t> msg, uint8_t out[32]) {
+  if (credential.empty() || msg.size() < 38 || msg.size() > 65536) {
+    return false;
+  }
+  static const uint8_t kZeroRandom[32] = {};
+  SHA256_CTX ctx;
+  const bool ok = SHA256_Init(&ctx) &&
+      SHA256_Update(&ctx, credential.data(), credential.size()) &&
+      SHA256_Update(&ctx, msg.data(), 6) &&
+      SHA256_Update(&ctx, kZeroRandom, sizeof(kZeroRandom)) &&
+      SHA256_Update(&ctx, msg.data() + 38, msg.size() - 38) &&
+      SHA256_Final(out, &ctx);
+  OPENSSL_cleanse(&ctx, sizeof(ctx));
+  return ok;
+}
+
+static bool seal_jls_client_hello(SSL_HANDSHAKE *hs, Span<uint8_t> msg) {
+  if (!hs->config->jls_client || hs->jls_hello_sealed) {
+    return true;
+  }
+  auto &state = *hs->config->jls_client;
+  JlsSecrets secrets;
+  if (msg.size() < 38 || msg[0] != SSL3_MT_CLIENT_HELLO ||
+      !jls_hello_hash(state.password, msg, secrets.key) ||
+      !jls_hello_hash(state.username, msg, secrets.nonce)) {
+    return false;
+  }
+  for (size_t attempt = 0; attempt < 32; ++attempt) {
+    ScopedEVP_CIPHER_CTX ctx;
+    int len = 0, tail = 0;
+    uint8_t random[32];
+    if (!RAND_bytes(secrets.seed, 16) ||
+        !EVP_EncryptInit_ex(ctx.get(), EVP_aes_256_gcm(), nullptr,
+                            nullptr, nullptr) ||
+        !EVP_CIPHER_CTX_ctrl(ctx.get(), EVP_CTRL_GCM_SET_IVLEN, 32, nullptr) ||
+        !EVP_EncryptInit_ex(ctx.get(), nullptr, nullptr,
+                            secrets.key, secrets.nonce) ||
+        !EVP_EncryptUpdate(ctx.get(), random, &len, secrets.seed, 16) ||
+        len != 16 ||
+        !EVP_EncryptFinal_ex(ctx.get(), random + len, &tail) || tail != 0 ||
+        !EVP_CIPHER_CTX_ctrl(ctx.get(), EVP_CTRL_GCM_GET_TAG, 16, random + 16)) {
+      return false;
+    }
+    static const uint8_t kHrrSuffix[8] =
+        {0x07, 0x9e, 0x09, 0xe2, 0xc8, 0xa8, 0x33, 0x9c};
+    if (OPENSSL_memcmp(random + 24, "DOWNGRD\x01", 8) == 0 ||
+        OPENSSL_memcmp(random + 24, "DOWNGRD\x00", 8) == 0 ||
+        OPENSSL_memcmp(random + 24, kHrrSuffix, 8) == 0) {
+      continue;
+    }
+    OPENSSL_memcpy(msg.data() + 6, random, sizeof(random));
+    OPENSSL_memcpy(hs->ssl->s3->client_random, random, sizeof(random));
+    hs->jls_hello_sealed = true;
+    return true;
+  }
+  OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+  return false;
+}
