+static bool verify_reality_certificate(SSL_HANDSHAKE *hs) {
+  // Consume once on every outcome, including malformed certificates.
+  struct ConsumeAuth {
+    SSL_HANDSHAKE *hs;
+    ~ConsumeAuth() { hs->ClearRealityAuth(); }
+  } consume{hs};
+  if (!hs->reality_auth_pending || hs->reality_authenticated ||
+      ssl_protocol_version(hs->ssl) != TLS1_3_VERSION ||
+      hs->new_session->peer_cert_type != TLSEXT_cert_type_x509 ||
+      sk_CRYPTO_BUFFER_num(hs->new_session->certs.get()) != 1 ||
+      !hs->peer_pubkey || EVP_PKEY_id(hs->peer_pubkey.get()) != EVP_PKEY_ED25519) {
+    return false;
+  }
+  const CRYPTO_BUFFER *buffer =
+      sk_CRYPTO_BUFFER_value(hs->new_session->certs.get(), 0);
+  if (CRYPTO_BUFFER_len(buffer) > 16384) {
+    return false;
+  }
+  CBS input, cert, tbs, algorithm, signature, ignored, tbs_algorithm;
+  CBS_init(&input, CRYPTO_BUFFER_data(buffer), CRYPTO_BUFFER_len(buffer));
+  // The native certificate parser already extracts/validates the SPKI used by
+  // CertificateVerify. Parse only the bounded signature envelope here; require
+  // both Ed25519 AlgorithmIdentifiers with absent parameters (RFC 8410).
+  static const uint8_t kEd25519Algorithm[] = {0x06, 0x03, 0x2b, 0x65, 0x70};
+  if (!CBS_get_asn1(&input, &cert, CBS_ASN1_SEQUENCE) || CBS_len(&input) != 0 ||
+      !CBS_get_asn1(&cert, &tbs, CBS_ASN1_SEQUENCE) ||
+      !CBS_get_asn1(&cert, &algorithm, CBS_ASN1_SEQUENCE) ||
+      !CBS_mem_equal(&algorithm, kEd25519Algorithm, sizeof(kEd25519Algorithm)) ||
+      !CBS_get_asn1(&cert, &signature, CBS_ASN1_BITSTRING) ||
+      CBS_len(&cert) != 0 || CBS_len(&signature) != 65 ||
+      CBS_data(&signature)[0] != 0) {
+    return false;
+  }
+  constexpr unsigned kVersionTag =
+      CBS_ASN1_CONTEXT_SPECIFIC | CBS_ASN1_CONSTRUCTED | 0;
+  if (!CBS_get_optional_asn1(&tbs, &ignored, nullptr, kVersionTag) ||
+      !CBS_get_asn1(&tbs, &ignored, CBS_ASN1_INTEGER) ||
+      !CBS_get_asn1(&tbs, &tbs_algorithm, CBS_ASN1_SEQUENCE) ||
+      !CBS_mem_equal(&tbs_algorithm, kEd25519Algorithm,
+                     sizeof(kEd25519Algorithm))) {
+    return false;
+  }
+  uint8_t public_key[32], expected[EVP_MAX_MD_SIZE];
+  size_t public_key_len = sizeof(public_key);
+  unsigned expected_len = 0;
+  if (!EVP_PKEY_get_raw_public_key(hs->peer_pubkey.get(), public_key,
+                                  &public_key_len) || public_key_len != 32 ||
+      !HMAC(EVP_sha512(), hs->reality_auth_key, sizeof(hs->reality_auth_key),
+             public_key, public_key_len, expected, &expected_len) ||
+      expected_len != 64) {
+    return false;
+  }
+  const bool valid = CRYPTO_memcmp(expected, CBS_data(&signature) + 1, 64) == 0;
+  OPENSSL_cleanse(expected, sizeof(expected));
+  hs->reality_authenticated = valid;
+  return valid;
+}
