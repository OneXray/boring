+                            const uint8_t *short_id, size_t short_id_len,
+                            const uint8_t client_version[3]) {
+  if (!ssl || !ssl->config || !server_public_key || !client_version ||
+      short_id_len > 8 || (short_id_len != 0 && !short_id) || ssl->server ||
+      SSL_is_dtls(ssl) || SSL_is_quic(ssl) || ssl->session ||
+      ssl->enable_early_data || ssl->s3->initial_handshake_complete ||
+      (ssl->s3->hs && ssl->s3->hs->max_version != 0) ||
+      ssl->config->reality_client ||
+      !ssl->config->client_ech_config_list.empty()) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  const uint16_t group = SSL_GROUP_X25519;
+  if (!SSL_set1_client_key_shares(ssl, &group, 1)) {
+    return 0;
+  }
+  ssl->config->reality_client.emplace();
+  auto &reality = *ssl->config->reality_client;
+  OPENSSL_memcpy(reality.server_public_key, server_public_key, 32);
+  OPENSSL_memcpy(reality.client_version, client_version, 3);
+  if (short_id_len != 0) {
+    OPENSSL_memcpy(reality.short_id, short_id, short_id_len);
+  }
+  return 1;
+}
