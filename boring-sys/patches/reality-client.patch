+static bool seal_reality_client_hello(SSL_HANDSHAKE *hs, Span<uint8_t> msg) {
+  if (!hs->config->reality_client) {
+    return true;
+  }
+  // Handshake header, legacy version, random, session ID length, session ID.
+  constexpr size_t kSessionIdOffset = 4 + 2 + 32 + 1;
+  if (hs->reality_hello_sealed || msg.size() < kSessionIdOffset + 32 ||
+      msg.size() > 65536 || msg[0] != SSL3_MT_CLIENT_HELLO ||
+      msg[kSessionIdOffset - 1] != 32 || hs->session_id.size() != 32 ||
+      hs->key_shares.size() != 1 ||
+      hs->key_shares[0]->GroupID() != SSL_GROUP_X25519 ||
+      !hs->pre_shared_keys.empty() || hs->pake_prover || hs->selected_ech_config) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return false;
+  }
+  struct SharedSecret {
+    uint8_t bytes[32] = {};
+    ~SharedSecret() { OPENSSL_cleanse(bytes, sizeof(bytes)); }
+  } shared;
+  const auto &reality = *hs->config->reality_client;
+  const uint8_t *random = hs->ssl->s3->client_random;
+  static const uint8_t kInfo[] = {'R', 'E', 'A', 'L', 'I', 'T', 'Y'};
+  if (!hs->key_shares[0]->RealitySharedSecret(shared.bytes,
+                                              reality.server_public_key) ||
+      !HKDF(hs->reality_auth_key, sizeof(hs->reality_auth_key), EVP_sha256(),
+            shared.bytes, sizeof(shared.bytes), random, 20, kInfo,
+            sizeof(kInfo))) {
+    hs->ClearRealityAuth();
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+    return false;
+  }
+  uint8_t plain[16] = {};
+  OPENSSL_memcpy(plain, reality.client_version, 3);
+  const auto now = ssl_ctx_get_current_time(hs->ssl->ctx.get()).tv_sec;
+  if (now < 0 || static_cast<uint64_t>(now) > UINT32_MAX) {
+    hs->ClearRealityAuth();
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return false;
+  }
+  const uint32_t timestamp = static_cast<uint32_t>(now);
+  for (size_t i = 0; i < 4; i++) {
+    plain[4 + i] = static_cast<uint8_t>(timestamp >> (24 - 8 * i));
+  }
+  OPENSSL_memcpy(plain + 8, reality.short_id, 8);
+  OPENSSL_memset(msg.data() + kSessionIdOffset, 0, 32);
+  ScopedEVP_AEAD_CTX aead;
+  uint8_t sealed[32];
+  size_t sealed_len = 0;
+  if (!EVP_AEAD_CTX_init(aead.get(), EVP_aead_aes_256_gcm(),
+                         hs->reality_auth_key, 32, 16, nullptr) ||
+      !EVP_AEAD_CTX_seal(aead.get(), sealed, &sealed_len, sizeof(sealed),
+                         random + 20, 12, plain, sizeof(plain), msg.data(),
+                         msg.size()) || sealed_len != 32) {
+    hs->ClearRealityAuth();
+    return false;
+  }
+  OPENSSL_memcpy(msg.data() + kSessionIdOffset, sealed, sizeof(sealed));
+  OPENSSL_memcpy(hs->session_id.data(), sealed, sizeof(sealed));
+  hs->reality_auth_pending = true;
+  hs->reality_hello_sealed = true;
+  return true;
+}
