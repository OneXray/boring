diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -2088,1 +2088,25 @@
+int SSL_set_restls_client(SSL *ssl, uint16_t version_hint,
+                          SSL_restls_hash_cb hash) {
+  if (!ssl || !ssl->config || !hash ||
+      (version_hint != TLS1_2_VERSION && version_hint != TLS1_3_VERSION) ||
+      ssl->server || SSL_is_dtls(ssl) || SSL_is_quic(ssl) ||
+      ssl->enable_early_data || ssl->s3->initial_handshake_complete ||
+      (ssl->s3->hs && ssl->s3->hs->max_version != 0) ||
+      ssl->config->restls_client || ssl->config->reality_client ||
+      ssl->config->shadow_tls_v3 || ssl->config->jls_client ||
+      !ssl->config->client_ech_config_list.empty() ||
+      (SSL_get_mode(ssl) & SSL_MODE_ENABLE_FALSE_START)) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  ssl->config->restls_client.emplace(SSL_CONFIG::RestlsClient{version_hint, hash});
+  return 1;
+}
+
+int SSL_restls_authenticated(const SSL *ssl) {
+  return ssl && ssl->config && ssl->config->restls_client &&
+      ssl->s3->restls_server_authenticated &&
+      ssl->s3->initial_handshake_complete && !SSL_in_init(ssl);
+}
